package leaf-tests

sourcedir = "."

depends = leaf,
          elab-util,
          finite,
          ilex,
          parser

modules = TestFramework,
          Backend.OpenQasm3SerializerTest,
          DSL.Helper,
          DSL.IntrinsicProofsTest,
          DSL.TypeLevelReductionTest,
          Lexer.LexerTest,
          Lexer.UnicodeNormalizationTest,
          Parser.DebugDump,
          Parser.ExpressionParseTest,
          Parser.FixtureSource,
          Parser.Fixtures,
          Parser.FunctionParseTest,
          Parser.Helper,
          Parser.TopModuleParseTest,
          Utils.ASTDebugPrinterTest,
          Utils.ASTPrettyPrinterTest,
          Validator.PostParseValidationTest,
          ScopeAndNameResolution.ValidationTest,
          ScopeAndNameResolution.PreludeTestHelper,
          ScopeAndNameResolution.PreludeTest,
          ScopeAndNameResolution.Helper,
          ScopeAndNameResolution.ResolveTestHelper,
          ScopeAndNameResolution.ResolveTest,
          TypeChecker.Helper,
          TypeChecker.NumericTest,
          TypeChecker.Phases.BodyCheckTest,
          TypeChecker.Phases.BodyCheckTestBeta,
          TypeChecker.Phases.ConstEvalTest,
          TypeChecker.Phases.EffectsCheckTest,
          TypeChecker.Phases.EffectsCheckTestBeta,
          TypeChecker.Phases.OwnershipCheckTest,
          TypeChecker.Phases.OwnershipCheckTestBeta,
          TypeChecker.Phases.OwnershipEventsTest,
          TypeChecker.Phases.OwnershipEventsTestBeta,
          TypeChecker.Phases.SignatureCheckTest,
          TypeChecker.Phases.SignatureCheckTestBeta,
          TypeChecker.Phases.TypedAstTranslationTest,
          TypeChecker.Phases.TypedAstTranslationTestBeta,
          TypeChecker.TypeCheckTest,
          TypeChecker.TypeCheckTestBeta,
          TypeChecker.TypeTranslationTest,
          Examples.CompileCodeExamples,
          Run

main = Run
executable = leaf-tests
